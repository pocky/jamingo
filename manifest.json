{
  "manifest_version": 3,
  "name": "Jamingo — Ultimate Guitar",
  "version": "2.0.9",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Jamingo — Ultimate Guitar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "description": "YouTube videos for Ultimate Guitar tabs, with saved versions and timing calibration.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tabs.ultimate-guitar.com/*"
      ],
      "js": [
        "core.js",
        "sync.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tabs.ultimate-guitar.com/*"
      ],
      "js": [
        "site-audio.js",
        "native-metronome.js",
        "player-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
